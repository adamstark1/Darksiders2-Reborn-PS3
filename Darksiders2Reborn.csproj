    <None Remove="Darksiders2Reborn.Launcher\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="darksiders2.pfx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
</Project>
