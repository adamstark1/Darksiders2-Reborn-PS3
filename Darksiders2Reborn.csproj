  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DNS" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Darksiders2Reborn.Launcher\**" />
